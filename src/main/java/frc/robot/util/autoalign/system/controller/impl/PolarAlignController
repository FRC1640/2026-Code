package frc.robot.util.autoalign.system.controller.impl;

import com.pathplanner.lib.config.PIDConstants;

import edu.wpi.first.math.MathUtil;
import edu.wpi.first.math.controller.PIDController;
import edu.wpi.first.math.filter.SlewRateLimiter;
import edu.wpi.first.math.geometry.Pose2d;
import edu.wpi.first.math.geometry.Rotation2d;
import edu.wpi.first.math.geometry.Translation2d;
import edu.wpi.first.math.kinematics.ChassisSpeeds;
import edu.wpi.first.math.util.Units;
import frc.robot.constants.RobotPIDConstants;
import frc.robot.subsystems.drive.DriveConstants;
import frc.robot.util.autoalign.system.controller.AlignControllerBase;
import frc.robot.util.autoalign.system.eventshandler.events.ECompleteReachPoint;
import frc.robot.util.autoalign.system.pointprovider.IAlignPointProvider;
public class PolarAlignController extends AlignControllerBase {
    private final PIDController R_PID;
    private final PIDController THETA_PID;
    private final PIDController ROTATION_PID;

    private final SlewRateLimiter R_SLEW_RATE_LIMITER;
    private final SlewRateLimiter THETA_SLEW_RATE_LIMITER;
    private final double maxAccelerationMetersPerSecondSquared = 3;

    private final double OUTPUT_DEADBAND = 0.1;
    private final double TRANSLATION_DEADBAND = 0.1;
    private final double ROTATION_DEADBAND = Units.degreesToRadians(5);

    private Rotation2d entryOffset;

    public PolarAlignController(IAlignPointProvider pointProvider, Rotation2d entryOffset) {
        super(pointProvider);
        this.entryOffset = entryOffset;
        R_PID = RobotPIDConstants.constructPID(new PIDConstants(0, 0, 0));
        THETA_PID = RobotPIDConstants.constructPID(new PIDConstants(0, 0, 0));
        ROTATION_PID = RobotPIDConstants.constructPID(new PIDConstants(0, 0, 0));
        // re0 this, not tuned

        R_SLEW_RATE_LIMITER = new SlewRateLimiter(maxAccelerationMetersPerSecondSquared);
        THETA_SLEW_RATE_LIMITER = new SlewRateLimiter(maxAccelerationMetersPerSecondSquared);
        getListenerManager().registerEventTrigger(()-> isFinished(), new ECompleteReachPoint());
}

@Override
public ChassisSpeeds calculate(ChassisSpeeds measuredSpeeds){
    Pose2d robot = pointProvider.getRobotPose();
    Pose2d target = pointProvider.getTargetPose();

    Translation2d translation = target.getTranslation().minus(robot.getTranslation());
    double r = translation.getNorm();
    Rotation2d theta = translation.getAngle();

    Rotation2d entryAngle = target.getRotation().plus(entryOffset);

    double velocity_r = R_PID.calculate(r, 0);
    velocity_r = MathUtil.clamp(velocity_r, -1, 1);
    velocity_r = MathUtil.applyDeadband(velocity_r, OUTPUT_DEADBAND);
    velocity_r *= DriveConstants.maxSpeed;
    velocity_r = R_SLEW_RATE_LIMITER.calculate(velocity_r);

    THETA_PID.enableContinuousInput(-Math.PI, Math.PI);
    double velocity_theta = THETA_PID.calculate(theta.getRadians(), entryAngle.getRadians()) * r;
    velocity_theta = MathUtil.clamp(velocity_theta, -1, 1);
    velocity_theta = MathUtil.applyDeadband(velocity_theta, OUTPUT_DEADBAND);
    velocity_theta *= DriveConstants.maxSpeed;
    velocity_theta = THETA_SLEW_RATE_LIMITER.calculate(velocity_theta);

    double cos_theta = Math.cos(theta.getRadians());
    double sin_theta = Math.sin(theta.getRadians());
    double xSpeed = velocity_r * cos_theta - velocity_theta * sin_theta; 
    double ySpeed = velocity_r * sin_theta + velocity_theta * cos_theta;
    double rotationalOutput = ROTATION_PID.calculate(robot.getRotation().minus(target.getRotation()).getRadians(), 0);

    rotationalOutput = MathUtil.clamp(rotationalOutput, -1, 1);
    rotationalOutput = MathUtil.applyDeadband(rotationalOutput, ROTATION_DEADBAND);
    rotationalOutput *= DriveConstants.maxOmega;

    return new ChassisSpeeds(xSpeed, ySpeed, rotationalOutput);
}

@Override
public boolean isAligning() {
    return !isFinished();
}

public boolean isFinished() {
    return pointProvider.getRobotPose().getTranslation()
    .getDistance(pointProvider.getTargetPose()
    .getTranslation()) < TRANSLATION_DEADBAND 
    && Math.abs(pointProvider.getRobotPose().getRotation()
    .minus(pointProvider.getTargetPose().getRotation())
    .getRadians()) < ROTATION_DEADBAND;
}
}